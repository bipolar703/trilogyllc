# Google AI Configuration (Required for Phase 2)
GOOGLE_AI_API_KEY=your_gemini_api_key_here

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Hexabot AI Agent"
NEXT_PUBLIC_COMPANY_NAME="Trilogy Trading LLC"

# Dashboard Configuration
DASHBOARD_ACCESS_TOKEN=trilogy-dashboard-2024

# Security
WEBHOOK_SECRET=your_webhook_secret_key
JWT_SECRET=your_jwt_secret_key

# Development
NODE_ENV=development

# Optional: Analytics & Monitoring
ANALYTICS_ID=your_analytics_id
SENTRY_DSN=your_sentry_dsn

# Optional: Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Optional: Slack Integration (for escalations)
SLACK_WEBHOOK_URL=your_slack_webhook_url
SLACK_CHANNEL=#customer-support